# ---------------------------------------------------------------------------
# vid2friend environment
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the two values from your Supabase
# project (Dashboard -> Project Settings -> API). See README section 2.
#
# IMPORTANT: Both values below end up inside the shipped extension bundle.
# That is expected and safe for the ANON key, because Row Level Security is
# what actually protects the data. NEVER put the `service_role` key here.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
